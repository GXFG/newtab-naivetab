{
  "name": "newtab-naivetab",
  "displayName": "NaiveTab - Visual Keyboard New Tab",
  "type": "module",
  "version": "2.7.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "description": "Visual keyboard for bookmarks & browser commands — one-press access. Drag & drop layout, full customization, focus mode, and cloud sync.",
  "keywords": [
    "newtab",
    "new-tab",
    "chrome-extension",
    "browser-extension",
    "bookmark",
    "visual-keyboard",
    "naivetab"
  ],
  "license": "GPL-3.0-or-later",
  "author": "GXFG",
  "scripts": {
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview site",
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev:prepare": "tsx scripts/prepare.ts",
    "dev:background": "pnpm run build:background -- --mode development",
    "dev:web": "vite",
    "dev:js": "pnpm run build:js -- --mode development",
    "build:prepare": "tsx scripts/prepare.ts",
    "fetch-bing": "tsx scripts/fetch-bing-wallpaper.ts --force",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "build": "run-p build:chrome build:firefox",
    "build:debug": "cross-env NODE_ENV=production BROWSER=chrome NO_MINIFY=true run-s clear:chrome build:web build:js build:prepare build:background",
    "analyze": "cross-env ANALYZE=true pnpm run build:chrome",
    "build:chrome": "cross-env NODE_ENV=production BROWSER=chrome run-s clear:chrome build:web build:js build:prepare build:background",
    "build:firefox": "cross-env NODE_ENV=production BROWSER=firefox run-s clear:firefox build:web build:js build:prepare build:background",
    "pack": "run-p pack:chrome pack:firefox pack:source",
    "pack:chrome": "tsx scripts/pack-zip.ts extension-chrome ./dist/naivetab-chrome.zip",
    "pack:firefox": "tsx scripts/pack-zip.ts extension-firefox ./dist/naivetab-firefox.zip",
    "pack:source": "tsx scripts/pack-source.ts",
    "clear": "run-p clear:chrome clear:firefox clear:source",
    "clear:chrome": "rimraf extension-chrome dist/naivetab-chrome.zip",
    "clear:firefox": "rimraf extension-firefox dist/naivetab-firefox.zip",
    "clear:source": "rimraf dist/naivetab-source.zip",
    "release": "run-s build pack",
    "lint:fix": "eslint './src/**/*.{vue,ts}' './scripts/**/*.ts' --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest test",
    "test:coverage": "vitest test --coverage",
    "check-patterns": "tsx scripts/check/check-patterns.ts",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "driver.js": "^1.9.0",
    "reka-ui": "^2.11.0",
    "tyme4ts": "^1.5.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.539",
    "@iconify/vue": "^5.0.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/chrome": "^0.1.43",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.1",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "animejs": "^4.5.0",
    "archiver": "^8.0.0",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^30.0.0",
    "user-agent-data-types": "^0.4.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue-demi": "^0.14.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm test -- --run && pnpm exec tsx scripts/check/validate-registries.ts && pnpm exec tsx scripts/check/validate-holidays.ts && pnpm check-patterns"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix"
    ]
  }
}
